<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
<!-- 
  <ItemGroup>
    <Protobuf Include="Protos\greet.proto" GrpcServices="Server" />
  </ItemGroup> -->

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
  <!-- <Protobuf Include="../_shared/proto/common.proto" GrpcServices="Client" /> -->
  <Protobuf Include="../_shared/proto/identity.proto" GrpcServices="Client" />
  <Protobuf Include="../_shared/proto/listing.proto" GrpcServices="Client" />
  <Protobuf Include="../_shared/proto/payment.proto" GrpcServices="Client" />
  <Protobuf Include="../_shared/proto/statistic.proto" GrpcServices="Client" />
</ItemGroup>

</Project>
