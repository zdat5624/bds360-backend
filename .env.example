DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=root

# ===============================
# SHARED SECRETS
# ===============================
JWT_SECRET=your_jwt_secret_here

# ===============================
# IDENTITY SERVICE
# ===============================
