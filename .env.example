# ===============================
# GLOBAL INFRASTRUCTURE
# ===============================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE_IDENTITY=bds360_identity_db
MYSQL_DATABASE_LISTING=bds360_listing_db
MYSQL_DATABASE_PAYMENT=bds360_payment_db
MYSQL_DATABASE_NOTIFICATION=bds360_notification_db

# ===============================
# CẤU HÌNH DATABASE CHO NESTJS (Chạy Local ở ngoài host)
# ===============================
